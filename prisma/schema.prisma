generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / Users ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  emailAccounts EmailAccount[]
  leadLists     LeadList[]
  campaigns     Campaign[]
  adAccounts    AdAccount[]
  leadProviders LeadProvider[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Sending identity ----------

// A connected Gmail (or other provider) mailbox used to actually send cold emails.
model EmailAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String   @default("google") // google | smtp (future)
  emailAddress   String
  displayName    String?
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  tokenExpiresAt DateTime?
  dailySendLimit Int      @default(80)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([userId, emailAddress])
}

// ---------- Lead data providers (search-based sourcing) ----------

// A connected third-party prospecting API (e.g. Apollo.io) used to search
// for and pull in new leads by criteria, as an alternative to CSV upload.
model LeadProvider {
  id          String   @id @default(cuid())
  userId      String
  provider    String   @default("apollo") // apollo | (future: hunter, peopledatalabs, ...)
  apiKey      String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ---------- Leads ----------

model LeadList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  source    String   @default("csv") // csv | manual | form | api
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads     Lead[]
  campaigns Campaign[]
}

enum LeadStatus {
  NEW
  ENROLLED
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  BOUNCED
  UNSUBSCRIBED
}

model Lead {
  id          String     @id @default(cuid())
  leadListId  String
  email       String
  firstName   String?
  lastName    String?
  company     String?
  title       String?
  website     String?
  phone       String?
  linkedinUrl String?
  customFields Json?
  status      LeadStatus @default(NEW)
  createdAt   DateTime   @default(now())

  leadList     LeadList             @relation(fields: [leadListId], references: [id], onDelete: Cascade)
  enrollments  CampaignEnrollment[]
  emailEvents  EmailEvent[]

  @@unique([leadListId, email])
  @@index([email])
}

// ---------- Campaigns (cold email sequences) ----------

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model Campaign {
  id             String         @id @default(cuid())
  userId         String
  leadListId     String
  emailAccountId String
  name           String
  status         CampaignStatus @default(DRAFT)
  timezone       String         @default("America/Toronto")
  sendWindowStart Int           @default(9)  // hour, 0-23
  sendWindowEnd   Int           @default(17)
  sendDays        Int[]         @default([1,2,3,4,5]) // 0=Sun..6=Sat
  stopOnReply     Boolean       @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadList     LeadList             @relation(fields: [leadListId], references: [id])
  emailAccount EmailAccount         @relation(fields: [emailAccountId], references: [id])
  steps        CampaignStep[]
  enrollments  CampaignEnrollment[]
  emailEvents  EmailEvent[]
}

model CampaignStep {
  id          String   @id @default(cuid())
  campaignId  String
  order       Int
  delayDays   Int      @default(0) // days after previous step (0 for first step)
  subject     String
  bodyHtml    String   @db.Text
  createdAt   DateTime @default(now())

  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enrollments CampaignEnrollment[]
  emailEvents EmailEvent[]

  @@unique([campaignId, order])
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  REPLIED
  COMPLETED
  UNSUBSCRIBED
  BOUNCED
}

model CampaignEnrollment {
  id             String           @id @default(cuid())
  campaignId     String
  leadId         String
  currentStepId  String?
  status         EnrollmentStatus @default(ACTIVE)
  nextSendAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  currentStep CampaignStep? @relation(fields: [currentStepId], references: [id])

  @@unique([campaignId, leadId])
  @@index([status, nextSendAt])
}

enum EmailEventType {
  QUEUED
  SENT
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

model EmailEvent {
  id          String         @id @default(cuid())
  campaignId  String
  stepId      String
  leadId      String
  type        EmailEventType
  messageId   String?
  threadId    String?
  detail      String?
  createdAt   DateTime       @default(now())

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step     CampaignStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([campaignId, type])
  @@index([leadId])
}

// ---------- Meta (Facebook/Instagram) Ads ----------

model AdAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String   @default("meta")
  businessName      String?
  adAccountId       String   // e.g. act_1234567890
  pageId            String?
  accessToken       String?  @db.Text // system-user long-lived token
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns AdCampaign[]

  @@unique([userId, adAccountId])
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  FAILED
  ARCHIVED
}

enum AdObjective {
  LEAD_GENERATION
  TRAFFIC
  ENGAGEMENT
  AWARENESS
}

model AdCampaign {
  id              String            @id @default(cuid())
  adAccountId     String
  name            String
  objective       AdObjective       @default(LEAD_GENERATION)
  status          AdCampaignStatus  @default(DRAFT)
  dailyBudgetCents Int              @default(2000)
  headline        String?
  primaryText     String?           @db.Text
  imageUrl        String?
  destinationUrl  String?
  targetLocations String[]          @default(["CA"])
  targetAgeMin    Int               @default(21)
  targetAgeMax    Int               @default(65)
  targetInterests String[]          @default([])
  metaCampaignId  String?
  metaAdSetId     String?
  metaAdId        String?
  lastError       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}
